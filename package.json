{
  "name": "solar-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify:orbits": "node scripts/verify-orbits.mjs",
    "fetch:dwarfs": "node scripts/fetch-dwarf-elements.mjs",
    "fetch:moons": "node scripts/fetch-moon-elements.mjs",
    "fetch:minor-moons": "node scripts/fetch-minor-moons.mjs",
    "textures": "node scripts/fetch-textures.mjs",
    "textures:force": "node scripts/fetch-textures.mjs --force",
    "textures:procedural": "node scripts/generate-textures.mjs --force",
    "postinstall": "node scripts/fetch-textures.mjs",
    "verify:bodies": "node scripts/verify-bodies.mjs",
    "verify:shaders": "node scripts/verify-shaders.mjs",
    "verify:framing": "node scripts/verify-framing.mjs",
    "verify": "npm run verify:orbits && npm run verify:bodies && npm run verify:shaders && npm run verify:framing && npm run verify:spacecraft -- --offline",
    "fetch:reference": "node scripts/fetch-dwarf-reference.mjs",
    "model:sun": "/Applications/Blender.app/Contents/MacOS/Blender -b 'Models/the-sun_206072e0-d3aa-4765-9fd0-1dd1c59e2aff.blend' --python scripts/export-sun-model.py -- public/models/sun.glb",
    "model:nasa": "node scripts/prepare-nasa-model.mjs",
    "models:eyes": "node scripts/fetch-eyes-models.mjs",
    "maps:earth": "node scripts/prepare-earth-maps.mjs",
    "models:spacecraft": "node scripts/fetch-spacecraft-models.mjs",
    "thumbs:spacecraft": "node scripts/render-spacecraft-thumbs.mjs",
    "fetch:spacecraft": "node scripts/fetch-spacecraft.mjs",
    "fetch:stars": "node scripts/fetch-stars.mjs",
    "fetch:attitude": "node scripts/fetch-spacecraft-attitude.mjs",
    "verify:spacecraft": "node scripts/verify-spacecraft.mjs",
    "verify:trails": "node scripts/verify-trails.mjs",
    "verify:flight": "node scripts/verify-flight.mjs",
    "verify:wheel": "node scripts/verify-wheel.mjs",
    "verify:attitude": "node scripts/verify-attitude.mjs",
    "verify:nav": "node scripts/verify-nav.mjs",
    "verify:sky": "node scripts/verify-sky.mjs",
    "verify:markers": "node scripts/verify-markers.mjs",
    "verify:models": "node scripts/verify-models.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "framer-motion": "^12.42.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "vite": "^8.1.5"
  }
}
