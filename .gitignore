node_modules
dist
dist-ssr
*.local
.DS_Store
.vite

# Planet textures are generated deterministically by scripts/generate-textures.mjs
# (runs automatically on `npm install`). Nothing binary lives in the repo.
public/textures/

# NASA's source models: ~150 MB of Blender exports, downloaded by hand from
# https://science.nasa.gov/3d-resources/. What the app ships is the repacked
# copy under public/models/, which IS committed, because it cannot be
# regenerated without this archive.
Models/Planets/
Models/Moons/
Models/Spacecraft/

# The three generic minor-moon asteroids, from Eyes' static bundle. Ignored for
# the same reason as the folders above, but unlike them this one is genuinely
# reproducible offline-to-online: `npm run models:generic` re-downloads it.
Models/MinorMoons/

# The comet nuclei, for the same reason as the folders above and verified the
# same way: all five are already committed as repacked copies under
# public/models/ (103p-hartley-2, 19p-borrelly, 1i-oumuamua,
# 67p-churyumov-gerasimenko, 9p-tempel-1). 20 MB of duplicate.
Models/Comets/

# Eyes' spacecraft SOURCE meshes. ~311 MB of raw exports, reproducible offline
# with `npm run models:spacecraft`, and never loaded by the app — only repacked
# into public/models/spacecraft/, which IS committed (below). Kept out of the
# history for the same reason as the other Models/ source trees above.
Models/Spacecraft/eyes/

# NOTE: public/models/spacecraft/ — the copies the app serves — used to be
# ignored here too, on the reasoning that they are regenerable. They are now
# committed so that a fresh clone and the deployed site carry the full model
# set without a rebuild step. 311 MB, largest file 32 MB (under GitHub's
# per-file limit), and unpreloaded, so it costs bandwidth only when a craft is
# actually drawn.

# Reference video pulled down to compare this app against Eyes frame by frame
# (see the Swift/AVFoundation extraction note — there is no ffmpeg here). It is
# working material, not an asset the app loads, and nothing in the tree
# references it.
original-*.mp4

# Reference photographs gathered while building the dossiers and checking the
# textures. Working material like the video above: nothing in the tree loads
# them, and the surfaces the app actually ships come from NASA's models and the
# Solar System Scope maps. Kept on disk, out of the history.
Planet Photos/

# Per-machine Claude Code settings. `launch.json` beside it is committed: it is
# the dev-server config the preview tooling reads, and it is the same for
# everyone.
.claude/settings.local.json
